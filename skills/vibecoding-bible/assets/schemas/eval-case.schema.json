{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecoding-bible/schemas/eval-case.schema.json",
  "title": "EvalSuite case",
  "type": "object",
  "required": ["id", "input", "expectation", "dimension", "origin"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"},
    "input": {"type": "string", "minLength": 1},
    "context_ref": {"type": "string"},
    "expectation": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["exact", "contains", "schema", "rubric", "abstain", "refuse"]},
        "value": {},
        "rationale": {"type": "string"}
      }
    },
    "dimension": {"type": "string"},
    "slice": {"type": "string"},
    "difficulty": {"enum": ["floor", "typical", "hard", "ceiling"]},
    "origin": {"enum": ["synthetic", "production", "incident", "regression", "handcrafted"]},
    "blocking": {"type": "boolean"},
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["deterministic", "schema", "model"]},
        "calibrated_against": {"type": "string"}
      }
    },
    "status": {"enum": ["draft", "active", "quarantined", "superseded", "deprecated"]}
  }
}
